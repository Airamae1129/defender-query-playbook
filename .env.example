# Defender Query Playbook server settings. Copy to .env (git-ignored) for local use;
# on Render, set these in the service's Environment settings instead. Never commit real keys.

# Team access code for the OSINT tab. Empty = OSINT turned off. Use a long random value and
# share it only with the team. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
PLAYBOOK_ACCESS_CODE=

# OSINT provider keys. A provider with an empty key shows as "Not configured".
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=
# URL-to-image screenshots (app.screenshotbase.com); runs only after the analyst confirms.
SCREENSHOTBASE_API_KEY=

# Reuse provider answers for this many hours (kept in server memory).
OSINT_CACHE_HOURS=24
# Requests per minute per provider (free-plan defaults). VirusTotal public API: 4/min.
ABUSEIPDB_RATE_PER_MIN=30
VIRUSTOTAL_RATE_PER_MIN=4
URLSCAN_RATE_PER_MIN=60
SHODAN_RATE_PER_MIN=60
OTX_RATE_PER_MIN=60
OSINT_TIMEOUT_MS=10000
# urlscan.io visibility for new scans: private | unlisted
URLSCAN_VISIBILITY=private
# Set to 1 behind a proxy (Render) so rate limits see the real client IP.
TRUST_PROXY=0
